{
  "name": "cable-quoting-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "parity": "vitest run tests/parity",
    "import:cost-master": "tsx scripts/import-cost-master.ts",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "test:db": "dotenv -e .env -- vitest run --config vitest.integration.config.ts",
    "user:add": "tsx scripts/create-user.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "decimal.js": "^10.4.3",
    "next": "^15.1.6",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dependency-cruiser": "^18.1.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "xlsx": "^0.18.5"
  }
}
