// Cable Quoting — persistence schema.
//
// Two rules from docs/ARCHITECTURE.md shape everything here:
//
//   1. Money columns are UNCONSTRAINED `NUMERIC`. `@db.Decimal` with no
//      arguments maps to plain `numeric`. A fixed scale was specified in the
//      original architecture doc and measurement disproved it: NUMERIC(18,6)
//      alters 53.7% of the imported cost master's 4,513 numeric values, which
//      carry up to 15 significant digits. The read path casts every one of
//      these with `::text` and rebuilds it through `dec()`, so Prisma's own
//      Decimal — a *different* constructor from the app's, `instanceof` is
//      false — never enters the pricing path.
//
//   2. Nothing is ever overwritten. Rates close with `validTo`; the audit log
//      is append-only, enforced by a trigger in the migration. History is the
//      product.
//
// Constraints Prisma's schema language cannot express — the EXCLUDE
// constraints that make overlapping rate periods impossible, and the
// append-only triggers — live in hand-written SQL appended to the generated
// migration. They are the real guarantee; this file is the typed surface.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

// Prisma 7 moved connection URLs out of the schema. They live in
// prisma.config.ts, which supplies a driver adapter — the pg pool for
// migrations and for the app at runtime.
datasource db {
  provider = "postgresql"
}

// ─── Identity ────────────────────────────────────────────────────────────
//
// Users are keyed by EMAIL, deliberately. It is the one identifier every
// identity provider agrees on, so moving from password sign-in to Google or
// Microsoft later means people sign in differently and keep their id, their
// role, and every audit row they ever wrote. Roles live here, never in the
// provider — who is a Rate Owner stays this system's decision.

enum Role {
  rateOwner
  engineer
  viewer
}

model AppUser {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique
  name  String
  role  Role

  /// Null when the user signs in through an external provider.
  passwordHash String? @map("password_hash")

  /// Soft delete. Nothing is ever removed.
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  auditEvents AuditEvent[]
  quotes      Quote[]

  @@map("app_user")
}

// ─── Effective-dated rates ───────────────────────────────────────────────
//
// `validTo` NULL means "in force". The EXCLUDE constraint in the migration
// makes two in-force rows for the same key impossible at the database level —
// not in application code someone could later bypass. Verified against both
// local Postgres 16.13 and Neon's Postgres 18.4.

model MaterialRate {
  id   String @id @default(uuid()) @db.Uuid
  /// The RM code from the cost master, e.g. `CC1F`, `XSAUINS`.
  code String

  description String
  uom         String

  /// The fixed rate. Ignored for LME-linked codes, which reprice off copper.
  rate Decimal @db.Decimal

  /// True for the 39 copper codes that reprice with the market.
  lmeLinked Boolean @map("lme_linked")

  /// Premium over LME metal value, per code. Set only on LME-linked rows.
  drawingPremium Decimal? @map("drawing_premium") @db.Decimal

  validFrom DateTime  @map("valid_from") @db.Timestamptz(6)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([code, validFrom(sort: Desc)])
  @@map("material_rate")
}

model MachineRate {
  id    String @id @default(uuid()) @db.Uuid
  code  String
  stage String

  rate Decimal @db.Decimal

  validFrom DateTime  @map("valid_from") @db.Timestamptz(6)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([code, validFrom(sort: Desc)])
  @@map("machine_rate")
}

/// The copper driver. A time series, append-only — a tick is a fact about a
/// moment, so it is never edited, only superseded by a later one.
model LmePrice {
  id String @id @default(uuid()) @db.Uuid

  /// The instant this price took effect.
  at DateTime @unique @map("at") @db.Timestamptz(6)

  /// USD per tonne.
  lme Decimal @db.Decimal

  /// OMR per USD. Carried per tick so a historic quote reconstructs on the
  /// FX of its day, not today's.
  fx Decimal @db.Decimal

  /// Free text: a person's name, or the feed that supplied it.
  enteredBy String @map("entered_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([at(sort: Desc)])
  @@map("lme_price")
}

// ─── Product library ─────────────────────────────────────────────────────
//
// Imported from the cost master. Read-only in this phase — the write path
// starts with rates, which is where the money is.

model Product {
  /// Synthetic. The natural key is (code, sourceSheet): two cables in the
  /// imported library carry the same product code in two different source
  /// sheets, with identical costs. Keyed on code alone, one would silently
  /// overwrite the other and the parity harness would drop from 99 to 97.
  id String @id @default(uuid()) @db.Uuid

  /// The product code as the cost master holds it. Not unique on its own.
  code        String
  sourceSheet String @map("source_sheet")
  designation String
  family      String
  standard    String

  cores      Int
  sizeMm2    Decimal @map("size_mm2") @db.Decimal
  conductor  String
  insulation String
  screen     String
  armour     String
  sheath     String
  voltage    String

  toolingPerKm Decimal @map("tooling_per_km") @db.Decimal

  bomLines   BomLine[]
  operations MachineOp[]
  overheads  OverheadLine[]

  @@unique([code, sourceSheet])
  @@index([code])
  @@index([family])
  @@map("product")
}

model BomLine {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  materialKey  String  @map("material_key")
  materialName String  @map("material_name")
  consumption  Decimal @db.Decimal
  /// Absolute quantity, as the source sheets hold it — never a percentage.
  scrap        Decimal @db.Decimal

  position Int

  @@index([productId])
  @@map("bom_line")
}

model MachineOp {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  machineKey  String  @map("machine_key")
  machineName String  @map("machine_name")
  sequence    Int
  hoursPerKm  Decimal @map("hours_per_km") @db.Decimal
  /// The multiplier this stage runs at. The cost master calls this column
  /// "Cores" but it is not an integer count — 117 of 728 rows are fractional,
  /// up to 97.2. Rounding it to an integer changes the cost.
  cores       Decimal @db.Decimal

  @@index([productId])
  @@map("machine_op")
}

model OverheadLine {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  key      String
  name     String
  amount   Decimal @db.Decimal
  position Int

  @@index([productId])
  @@map("overhead_line")
}

// ─── Audit ───────────────────────────────────────────────────────────────
//
// Append-only, enforced by a trigger. Every rate change records who, when,
// the previous value and the new one. Values are stored as text because this
// table records *what was written*, verbatim — reformatting an audited value
// would defeat its purpose.

model AuditEvent {
  id String @id @default(uuid()) @db.Uuid

  at DateTime @default(now()) @db.Timestamptz(6)

  actorId String? @map("actor_id") @db.Uuid
  actor   AppUser? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  /// Kept alongside the id so the trail stays readable if a user is ever
  /// disabled or renamed.
  actorEmail String @map("actor_email")

  /// e.g. `material_rate:XSAUINS`, `lme_price`.
  entity String
  field  String

  previous String
  next     String
  reason   String?

  @@index([at(sort: Desc)])
  @@index([entity, at(sort: Desc)])
  @@map("audit_event")
}

// ─── Quotes ──────────────────────────────────────────────────────────────
//
// Reconstruction is belt and braces (ARCHITECTURE.md §5). A quote records
// `pricedAt`, so the rates it was struck on can be re-resolved; AND it freezes
// the complete cost breakdown as JSONB. Either alone is insufficient — the
// first breaks if history is ever corrected, the second cannot say *which*
// rate row a number came from. Together, "why was this 4.812 in March?" is one
// click and cannot drift.

enum QuoteStatus {
  draft
  approved
  sent
  lapsed
}

model Quote {
  id     String      @id @default(uuid()) @db.Uuid
  /// Human-facing, sequential per year: Q-2026-0148.
  number String      @unique
  status QuoteStatus @default(draft)

  customer String
  /// Free text on the document: delivery, payment, anything negotiated.
  terms    String?

  /// The instant the rates were resolved at. The engine can re-resolve from it.
  pricedAt DateTime @map("priced_at") @db.Timestamptz(6)
  /// After this, the price is no longer offered. Copper moves.
  validUntil DateTime @map("valid_until") @db.Timestamptz(6)

  /// The strike, stamped on the document itself so the paper carries its own
  /// provenance even when separated from this system.
  lmeStruck     Decimal @map("lme_struck") @db.Decimal
  fxStruck      Decimal @map("fx_struck") @db.Decimal
  marginPercent Decimal @map("margin_percent") @db.Decimal

  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   AppUser? @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz(6)

  lines QuoteLine[]

  @@index([status, createdAt(sort: Desc)])
  @@index([customer])
  @@map("quote")
}

model QuoteLine {
  id      String @id @default(uuid()) @db.Uuid
  quoteId String @map("quote_id") @db.Uuid
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  position Int

  /// What the customer asked for, verbatim. Kept because a quote is answerable
  /// to the enquiry, not only to the product it was matched to.
  requestText String @map("request_text")

  productCode String @map("product_code")
  sourceSheet String @map("source_sheet")
  designation String

  quantityMetres Decimal @map("quantity_metres") @db.Decimal
  unitRate       Decimal @map("unit_rate") @db.Decimal
  lineTotal      Decimal @map("line_total") @db.Decimal

  /// The complete CostBreakdown, frozen at approval. Every material, every
  /// machine stage, every rate row it drew from.
  costSnapshot Json @map("cost_snapshot")

  @@unique([quoteId, position])
  @@index([quoteId])
  @@map("quote_line")
}
