// Cable Quoting — persistence schema.
//
// Two rules from docs/ARCHITECTURE.md shape everything here:
//
//   1. Money columns are UNCONSTRAINED `NUMERIC`. `@db.Decimal` with no
//      arguments maps to plain `numeric`. A fixed scale was specified in the
//      original architecture doc and measurement disproved it: NUMERIC(18,6)
//      alters 53.7% of the imported cost master's 4,513 numeric values, which
//      carry up to 15 significant digits. The read path casts every one of
//      these with `::text` and rebuilds it through `dec()`, so Prisma's own
//      Decimal — a *different* constructor from the app's, `instanceof` is
//      false — never enters the pricing path.
//
//   2. Nothing is ever overwritten. Rates close with `validTo`; the audit log
//      is append-only, enforced by a trigger in the migration. History is the
//      product.
//
// Constraints Prisma's schema language cannot express — the EXCLUDE
// constraints that make overlapping rate periods impossible, and the
// append-only triggers — live in hand-written SQL appended to the generated
// migration. They are the real guarantee; this file is the typed surface.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

// Prisma 7 moved connection URLs out of the schema. They live in
// prisma.config.ts, which supplies a driver adapter — the pg pool for
// migrations and for the app at runtime.
datasource db {
  provider = "postgresql"
}

// ─── Identity ────────────────────────────────────────────────────────────
//
// Users are keyed by EMAIL, deliberately. It is the one identifier every
// identity provider agrees on, so moving from password sign-in to Google or
// Microsoft later means people sign in differently and keep their id, their
// role, and every audit row they ever wrote. Roles live here, never in the
// provider — who is a Rate Owner stays this system's decision.

enum Role {
  rateOwner
  engineer
  viewer
}

model AppUser {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique
  name  String
  role  Role

  /// Null when the user signs in through an external provider.
  passwordHash String? @map("password_hash")

  /// Soft delete. Nothing is ever removed.
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  auditEvents       AuditEvent[]
  quotes            Quote[]
  jobs              Job[]
  revisedProducts   Product[]
  jobDecisions      JobLine[]
  vocabularyTerms   VocabularyTerm[]
  substitutionRules SubstitutionRule[]

  @@map("app_user")
}

// ─── Effective-dated rates ───────────────────────────────────────────────
//
// `validTo` NULL means "in force". The EXCLUDE constraint in the migration
// makes two in-force rows for the same key impossible at the database level —
// not in application code someone could later bypass. Verified against both
// local Postgres 16.13 and Neon's Postgres 18.4.

model MaterialRate {
  id   String @id @default(uuid()) @db.Uuid
  /// The RM code from the cost master, e.g. `CC1F`, `XSAUINS`.
  code String

  description String
  uom         String

  /// The fixed rate. Ignored for LME-linked codes, which reprice off copper.
  rate Decimal @db.Decimal

  /// True for the 39 copper codes that reprice with the market.
  lmeLinked Boolean @map("lme_linked")

  /// Premium over LME metal value, per code. Set only on LME-linked rows.
  drawingPremium Decimal? @map("drawing_premium") @db.Decimal

  validFrom DateTime  @map("valid_from") @db.Timestamptz(6)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([code, validFrom(sort: Desc)])
  @@map("material_rate")
}

model MachineRate {
  id    String @id @default(uuid()) @db.Uuid
  code  String
  stage String

  rate Decimal @db.Decimal

  validFrom DateTime  @map("valid_from") @db.Timestamptz(6)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([code, validFrom(sort: Desc)])
  @@map("machine_rate")
}

/// The copper driver. A time series, append-only — a tick is a fact about a
/// moment, so it is never edited, only superseded by a later one.
model LmePrice {
  id String @id @default(uuid()) @db.Uuid

  /// The instant this price took effect.
  at DateTime @unique @map("at") @db.Timestamptz(6)

  /// USD per tonne.
  lme Decimal @db.Decimal

  /// OMR per USD. Carried per tick so a historic quote reconstructs on the
  /// FX of its day, not today's.
  fx Decimal @db.Decimal

  /// Free text: a person's name, or the feed that supplied it.
  enteredBy String @map("entered_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([at(sort: Desc)])
  @@map("lme_price")
}

// ─── Product library ─────────────────────────────────────────────────────
//
// Imported from the cost master. Read-only in this phase — the write path
// starts with rates, which is where the money is.

model Product {
  /// Synthetic. The natural key is (code, sourceSheet): two cables in the
  /// imported library carry the same product code in two different source
  /// sheets, with identical costs. Keyed on code alone, one would silently
  /// overwrite the other and the parity harness would drop from 99 to 97.
  id String @id @default(uuid()) @db.Uuid

  /// The product code as the cost master holds it. Not unique on its own.
  code        String
  sourceSheet String @map("source_sheet")
  designation String
  family      String
  standard    String

  cores      Int
  sizeMm2    Decimal @map("size_mm2") @db.Decimal
  conductor  String
  insulation String
  screen     String
  armour     String
  sheath     String
  voltage    String

  toolingPerKm Decimal @map("tooling_per_km") @db.Decimal

  /// Set the first time a person changes this product's design.
  ///
  /// The parity harness asserts every imported product still reproduces its
  /// source cost sheet. A revised product legitimately does not — that is the
  /// point of revising it — so parity excludes these and *says how many*,
  /// rather than quietly weakening to whatever the library happens to contain.
  revisedAt   DateTime? @map("revised_at") @db.Timestamptz(6)
  revisedById String?   @map("revised_by_id") @db.Uuid
  revisedBy   AppUser?  @relation(fields: [revisedById], references: [id], onDelete: Restrict)

  bomLines   BomLine[]
  operations MachineOp[]
  overheads  OverheadLine[]

  @@unique([code, sourceSheet])
  @@index([code])
  @@index([family])
  @@map("product")
}

model BomLine {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  materialKey  String  @map("material_key")
  materialName String  @map("material_name")
  consumption  Decimal @db.Decimal
  /// Absolute quantity, as the source sheets hold it — never a percentage.
  scrap        Decimal @db.Decimal

  position Int

  @@index([productId])
  @@map("bom_line")
}

model MachineOp {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  machineKey  String  @map("machine_key")
  machineName String  @map("machine_name")
  sequence    Int
  hoursPerKm  Decimal @map("hours_per_km") @db.Decimal
  /// The multiplier this stage runs at. The cost master calls this column
  /// "Cores" but it is not an integer count — 117 of 728 rows are fractional,
  /// up to 97.2. Rounding it to an integer changes the cost.
  cores       Decimal @db.Decimal

  @@index([productId])
  @@map("machine_op")
}

model OverheadLine {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  key      String
  name     String
  amount   Decimal @db.Decimal
  position Int

  @@index([productId])
  @@map("overhead_line")
}

// ─── Audit ───────────────────────────────────────────────────────────────
//
// Append-only, enforced by a trigger. Every rate change records who, when,
// the previous value and the new one. Values are stored as text because this
// table records *what was written*, verbatim — reformatting an audited value
// would defeat its purpose.

model AuditEvent {
  id String @id @default(uuid()) @db.Uuid

  at DateTime @default(now()) @db.Timestamptz(6)

  actorId String? @map("actor_id") @db.Uuid
  actor   AppUser? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  /// Kept alongside the id so the trail stays readable if a user is ever
  /// disabled or renamed.
  actorEmail String @map("actor_email")

  /// e.g. `material_rate:XSAUINS`, `lme_price`.
  entity String
  field  String

  previous String
  next     String
  reason   String?

  @@index([at(sort: Desc)])
  @@index([entity, at(sort: Desc)])
  @@map("audit_event")
}

// ─── Quotes ──────────────────────────────────────────────────────────────
//
// Reconstruction is belt and braces (ARCHITECTURE.md §5). A quote records
// `pricedAt`, so the rates it was struck on can be re-resolved; AND it freezes
// the complete cost breakdown as JSONB. Either alone is insufficient — the
// first breaks if history is ever corrected, the second cannot say *which*
// rate row a number came from. Together, "why was this 4.812 in March?" is one
// click and cannot drift.

enum QuoteStatus {
  draft
  approved
  sent
  lapsed
}

model Quote {
  id     String      @id @default(uuid()) @db.Uuid
  /// Human-facing, sequential per year: Q-2026-0148.
  number String      @unique
  status QuoteStatus @default(draft)

  customer String
  /// Free text on the document: delivery, payment, anything negotiated.
  terms    String?

  /// The instant the rates were resolved at. The engine can re-resolve from it.
  pricedAt DateTime @map("priced_at") @db.Timestamptz(6)
  /// After this, the price is no longer offered. Copper moves.
  validUntil DateTime @map("valid_until") @db.Timestamptz(6)

  /// The strike, stamped on the document itself so the paper carries its own
  /// provenance even when separated from this system.
  lmeStruck     Decimal @map("lme_struck") @db.Decimal
  fxStruck      Decimal @map("fx_struck") @db.Decimal
  marginPercent Decimal @map("margin_percent") @db.Decimal

  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   AppUser? @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz(6)

  /// The quote this one replaces, and the one that replaced it.
  ///
  /// A chain, not a tree: `@unique` means one quote replaces at most one other
  /// and is replaced by at most one. Two quotes both claiming to replace the
  /// same one would be a contradiction nobody could resolve from the record.
  ///
  /// A superseded quote is never edited and never deleted — it is what a
  /// customer was told, and the correction is a new document that says so.
  supersedesId String? @unique @map("supersedes_id") @db.Uuid
  supersedes   Quote?  @relation("Supersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy Quote?  @relation("Supersession")

  lines QuoteLine[]
  job   Job?

  @@index([status, createdAt(sort: Desc)])
  @@index([customer])
  @@map("quote")
}

model QuoteLine {
  id      String @id @default(uuid()) @db.Uuid
  quoteId String @map("quote_id") @db.Uuid
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  position Int

  /// What the customer asked for, verbatim. Kept because a quote is answerable
  /// to the enquiry, not only to the product it was matched to.
  requestText String @map("request_text")

  productCode String @map("product_code")
  sourceSheet String @map("source_sheet")
  designation String

  quantityMetres Decimal @map("quantity_metres") @db.Decimal
  unitRate       Decimal @map("unit_rate") @db.Decimal
  lineTotal      Decimal @map("line_total") @db.Decimal

  /// The complete CostBreakdown, frozen at approval. Every material, every
  /// machine stage, every rate row it drew from.
  ///
  /// **Null when the line was priced by hand.** Deliberately not a zero-filled
  /// tree: a line nobody costed has no materials, no machine time and no
  /// copper mass, and inventing those would put false claims on an auditable
  /// document. The absence, plus the override below, is the truth.
  costSnapshot Json? @map("cost_snapshot")

  /// Set when a person, not the app, settled this line.
  ///
  /// A rate means they replaced the price outright; a decision with no rate
  /// means they named the product and left the costing to the engine. Both are
  /// human decisions, and the spec requires that fact to persist onto the
  /// quote — so the mono `M` marker on a quote line is a property of the
  /// record, not a guess a screen makes.
  ///
  /// The reason is not optional in practice: a CHECK constraint refuses a
  /// decision without one.
  overrideRate   Decimal?  @map("override_rate") @db.Decimal
  decisionReason String?   @map("decision_reason")
  decisionBy     String?   @map("decision_by")
  decisionAt     DateTime? @map("decision_at") @db.Timestamptz(6)

  @@unique([quoteId, position])
  @@index([quoteId])
  @@map("quote_line")
}

// ─── Jobs ────────────────────────────────────────────────────────────────
//
// A job is an RFQ under review. It holds the customer's text and *the
// decisions a human made about it* — not the prices. Prices are recomputed on
// every render from the rates in force, so a draft job left open over a copper
// move reprices rather than going stale, and freezing happens exactly once, at
// approval, into the quote.
//
// That split is the reason a decision is worth storing at all: "price line 4
// as product X, because the customer confirmed it" stays true across a
// repricing. "Line 4 is 6.030" does not.

enum JobStatus {
  /// Being reviewed. Lines still open, decisions still being made.
  review
  /// Turned into a quote. The job is now history.
  approved
  /// Closed without quoting.
  abandoned
}

enum JobSource {
  paste
  upload
  email
}

model Job {
  id String @id @default(uuid()) @db.Uuid

  /// Human-facing, sequential per year: J-2026-0042.
  reference String    @unique
  status    JobStatus @default(review)

  customer String?
  /// Free text destined for the quote if this job is approved.
  terms    String?

  source     JobSource @default(paste)
  /// Filename, mail subject, or "pasted" — where the text came from.
  sourceName String?   @map("source_name")

  /// What the reader made of the document, in words: how many lines it found,
  /// and — the part that matters — which rows it left out and why.
  ///
  /// Dropping these would mean a line vanishing from the customer's enquiry
  /// with nobody told, which is the exact failure this app exists to prevent.
  /// Kept on the job rather than shown once at upload, because the engineer
  /// who needs them may not be the person who did the uploading.
  sourceNotes String[] @map("source_notes")

  /// The RFQ exactly as received. Re-parsed on every render, never mutated by
  /// the app — an engineer's corrections live on the lines, not in the text.
  rawText String @map("raw_text")

  /// The document as the reader saw it, before anything was thrown away.
  ///
  /// `rawText` above holds the *extracted* lines, which is what the app prices.
  /// This holds every line of the file they were taken from — the covering
  /// letter, the terms, the rows with no quantity. Without it there is nothing
  /// to show an engineer who asks where a number came from, and Phase 3's
  /// promise is precisely that they never open the attachment to find out.
  ///
  /// Null for a pasted enquiry, where the text *is* the document.
  sourceText String? @map("source_text")

  /// Where each extracted line came from, in line order:
  /// `[{ "line": 12, "where": "Schedule of Cables, row 4" }, …]`.
  ///
  /// JSONB rather than two parallel arrays, so an index and its label cannot
  /// drift apart. Cleared when the enquiry text is revised: positions move, and
  /// provenance that points at the wrong row is worse than none.
  lineSources Json? @map("line_sources")

  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   AppUser? @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// `@default(now())` as well as `@updatedAt`: the latter is applied by the
  /// client, so without it any statement that does not go through Prisma —
  /// a migration backfill, a psql fix, the seed — fails on a NOT NULL.
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Set when the job became a quote.
  quoteId String? @unique @map("quote_id") @db.Uuid
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  lines JobLine[]

  @@index([status, createdAt(sort: Desc)])
  @@index([customer])
  @@map("job")
}

/// One decision, about one line, by one person.
///
/// A row exists only where a human has actually decided something — a job with
/// no open lines has no `job_line` rows at all. The position is the line's
/// index in `raw_text`, which is why the text is immutable: renumbering it
/// would silently reassign every decision.
model JobLine {
  id    String @id @default(uuid()) @db.Uuid
  jobId String @map("job_id") @db.Uuid
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  position Int

  /// A price set by hand. Requires `decisionReason`.
  overrideRate Decimal? @map("override_rate") @db.Decimal

  /// "Price this line as product X." Requires `decisionReason`.
  chosenProductCode String? @map("chosen_product_code")
  chosenSourceSheet String? @map("chosen_source_sheet")

  /// Why. Never optional in practice — the CHECK constraint in the migration
  /// refuses a decision without one.
  decisionReason String? @map("decision_reason")

  decidedById String?  @map("decided_by_id") @db.Uuid
  decidedBy   AppUser? @relation(fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(6)

  @@unique([jobId, position])
  @@index([jobId])
  @@map("job_line")
}

// ─── Vocabulary ──────────────────────────────────────────────────────────
//
// The terms shipped with the app live in code, because they are exactly the
// canonical values the imported library uses and changing one would break
// matching. Everything *learned* lives here. The spec's promise is that the
// app "stops asking after the first months", and a constant compiled into the
// bundle cannot keep it.

model VocabularyTerm {
  id String @id @default(uuid()) @db.Uuid

  /// Nuhas's own term, as held in the product library.
  canonical String
  /// conductor | insulation | screen | armour | sheath | voltage | standard
  axis      String

  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   AppUser? @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  synonyms VocabularySynonym[]

  /// Redundant with the primary key, and required: it is the target of the
  /// composite foreign key that pins each synonym's axis to its term's.
  @@unique([id, axis])
  @@unique([axis, canonical])
  @@map("vocabulary_term")
}

model VocabularySynonym {
  id     String         @id @default(uuid()) @db.Uuid
  termId String         @map("term_id") @db.Uuid
  term   VocabularyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  /// Denormalised from the term, because uniqueness has to be enforced per
  /// axis and a Postgres index expression cannot reach into another table. A
  /// composite foreign key on (term_id, axis) in the migration makes it
  /// impossible for this to disagree with the term it belongs to.
  axis String

  /// Folded on write: lower-cased, punctuation stripped, whitespace collapsed.
  phrase String

  /// How often a customer has written it, and when it was last seen. This is
  /// what makes "learned this month" a measurement rather than an anecdote.
  timesSeen  Int       @default(0) @map("times_seen")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// One phrase means one thing on one axis. Without this, teaching the app
  /// that "XLPO" is a sheath and separately that it is an insulation would
  /// make every line containing it ambiguous, and the parser would silently
  /// pick whichever row came back first.
  @@unique([axis, phrase])
  @@index([termId])
  @@map("vocabulary_synonym")
}

/// A substitution the Rate Owner has declared safe.
///
/// Ships empty. A permissive allowlist is how wrong prices get out, so each
/// row is a judgement someone made and signed for, and retiring one closes it
/// rather than deleting it — a quote struck on a rule has to stay explainable
/// after the rule is withdrawn.
model SubstitutionRule {
  id String @id @default(uuid()) @db.Uuid

  axis     String
  /// The term the library holds.
  fromTerm String @map("from_term")
  /// The term a customer asked for.
  toTerm   String @map("to_term")

  /// Why this substitution is safe. Shown on every line priced through it.
  rationale String

  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   AppUser? @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Null means in force.
  retiredAt   DateTime? @map("retired_at") @db.Timestamptz(6)

  @@index([axis])
  @@map("substitution_rule")
}
